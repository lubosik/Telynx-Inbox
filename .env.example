# Telnyx
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PHONE_NUMBER=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
# Legacy v1 HMAC secret retained for existing message processing.
WEBHOOK_SECRET=
# Public (not private) key from Telnyx Mission Control. Required before live
# delivery/reply evidence can enter revenue attribution or sentiment metrics.
TELNYX_PUBLIC_KEY=

# GoHighLevel
GHL_AGENCY_TOKEN=   # PIT token — needs contacts.readonly + conversations.readonly scopes
GHL_COMPANY_ID=
GHL_LOCATION_ID=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Analytics
# Business data is stored in UTC and reported using this reliable activity floor.
ANALYTICS_RELIABLE_FROM=2026-01-16
# Optional source-specific history floors used for honest partial-history notices.
ANALYTICS_MESSAGING_RELIABLE_FROM=2026-04-29
ANALYTICS_RECOVERY_RELIABLE_FROM=2026-05-27
ANALYTICS_CALLS_RELIABLE_FROM=2026-06-11
# Comma-separated E.164 phones / Woo order IDs excluded as staff, internal, or test data.
ANALYTICS_EXCLUDED_PHONES=
ANALYTICS_EXCLUDED_ORDER_IDS=
# Keep blank/off. Set to the exact value YES only for a separately approved
# historical write, and still pass --persist to the relevant backfill script.
ANALYTICS_BACKFILL_APPROVED=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Enforced in code on every request: only these reviewed models/providers may run.
OPENROUTER_ALLOWED_MODELS=anthropic/claude-haiku-4.5
OPENROUTER_ALLOWED_PROVIDERS=amazon-bedrock,google-vertex

# Private call recordings
CALL_RECORDING_RETENTION_DAYS=30
CALL_RECORDING_SIGNED_URL_SECONDS=60
# Destructive retention remains off until the owner approves the first dry run.
CALL_RECORDING_RETENTION_ENFORCED=false

# Auth
INBOX_PASSWORD=
SESSION_SECRET=

# App
PORT=3000
NODE_ENV=production
APP_URL=

# ── Outbound email (Maton, via the authorised Gmail connection) ────────────
# Used by lib/email.js for the invitation email and nothing else yet.
#
# Maton rather than an SMTP/API provider because it needs NO DNS CHANGES.
# vicipeptides.com mail is hosted elsewhere and its records are not to be
# touched; the Gmail connection is already authorised and already sends as
# support@vicipeptides.com, so there is no sending domain to verify.
#
# All THREE of MATON_API_KEY, MATON_GMAIL_CONNECTION_ID and EMAIL_FROM are
# required before a single message is sent. With any of them missing,
# sendEmail() returns { sent: false, reason: 'not_configured' }, logs once, and
# never throws — invitations still succeed and still return their link, and the
# API response says emailSent: false so nobody is told a mail went that did not.
#
# Find the connection id with:
#   curl -H "Authorization: Bearer $MATON_API_KEY" https://ctrl.maton.ai/connections
# and take the id of the ACTIVE google-mail connection. Never paste a real key
# or a real connection id into this file.
MATON_API_KEY=                   # Maton API key (leave blank to disable email)
MATON_GMAIL_CONNECTION_ID=       # id of the ACTIVE google-mail connection, sent as the Maton-Connection header
EMAIL_FROM=                      # bare address only, e.g. support@vicipeptides.com — must match the connection
EMAIL_FROM_NAME=Vici Inbox       # optional display name; defaults to "Vici Inbox"
# APP_URL above must also be set: it builds the ${APP_URL}/accept-invite?token=...
# link inside the invitation email. Without it no invitation email is sent.

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Accounts, roles and the Activity Center ────────────────────────────────
# The shared INBOX_PASSWORD login still works and resolves to one named
# "Team" identity. These two control it. Retiring the shared password once
# everyone has a named account is a flip of the first, not a deploy.
LEGACY_SHARED_LOGIN=enabled          # enabled | disabled
LEGACY_SHARED_ROLE=admin             # admin | agent — reconciled into the DB at boot

# SESSION_SECRET is now MANDATORY. The server refuses to start without it,
# because the old fallback value was committed to this repository and an unset
# secret meant the session cookie signature was forgeable from the source.

# ── Machine credentials ────────────────────────────────────────────────────
# Bearer token for POST /admin/* (backfills, release-notify). Falls back to
# INBOX_PASSWORD when unset, so the current deploy is unaffected. Set it so the
# machine credential can be rotated without changing the login people type.
ADMIN_API_TOKEN=
# Dedicated secret for the GHL automation calling POST /webhook/send. Falls back
# to WEBHOOK_SECRET, which is also the legacy Telnyx v1 signing secret. Set this
# so one value stops serving two unrelated purposes.
GHL_WEBHOOK_SECRET=

# ── APNs (native iPhone push) ──────────────────────────────────────────────
# REQUIRED for any native iOS notification: message alerts from the Telnyx
# inbound webhook, badge counts, and POST /admin/release-notify. lib/apns-notify.js
# returns null and silently sends nothing unless all three of KEY_ID, TEAM_ID and
# KEY_P8_BASE64 are set. AGENTS.md names them as Railway runtime configuration.
# These are a dedicated Apple Developer APNs key — NOT the App Store Connect API
# key and NOT the Telnyx VoIP credential. Never paste a real .p8 into this file.
APNS_KEY_ID=                     # 10-char Key ID of the APNs .p8 (required for iOS push)
APNS_TEAM_ID=                    # 10-char Apple Developer Team ID (required for iOS push)
APNS_KEY_P8_BASE64=              # base64 of the APNs .p8 private key (required for iOS push)
# Optional. Push topic / app bundle id. Defaults to com.vicipeptides.inbox.
APNS_BUNDLE_ID=

# ── Dedicated iOS SIP credential ───────────────────────────────────────────
# Optional but strongly preferred. lib/voice-credentials.js uses this pair only
# when BOTH are present, so a half-applied update can never mix credentials from
# two different SIP users. When either is missing it falls back to the legacy
# TELNYX_SIP_USERNAME / TELNYX_SIP_PASSWORD above, which is the rollback path —
# never overwrite or delete the legacy pair during a rotation.
TELNYX_IOS_SIP_USERNAME=         # optional; set together with the password below
TELNYX_IOS_SIP_PASSWORD=         # optional; set together with the username above

# ── WooCommerce ────────────────────────────────────────────────────────────
# REQUIRED for orders, payment-recovery flows and revenue attribution.
# WC_URL is optional; woocommerce.js defaults to the production store's
# /wp-json/wc/v3 root when it is unset.
WC_URL=                          # optional; WooCommerce REST v3 base URL
WC_CONSUMER_KEY=                 # REQUIRED — Woo REST consumer key (ck_...)
WC_CONSUMER_SECRET=              # REQUIRED — Woo REST consumer secret (cs_...)
# Optional but recommended. HMAC secret for POST /webhook/woocommerce. When
# unset the signature check is SKIPPED, so set it in any deployed environment.
WC_WEBHOOK_SECRET=

# ── ShipStation ────────────────────────────────────────────────────────────
# REQUIRED for shipment/delivery flows and tracking lookups.
SS_API_KEY=                      # REQUIRED — ShipStation API key
SS_API_SECRET=                   # REQUIRED — ShipStation API secret
# Optional but recommended. Shared secret compared against the ShipStation
# webhook. When unset the check is SKIPPED, so set it in any deployed environment.
SS_WEBHOOK_SECRET=

# ── Payment handles shown in recovery SMS copy ─────────────────────────────
# Optional. Both have hard-coded defaults in flows/failed.js and flows/hold.js;
# set them only to override what customers are told to pay to.
VENMO_HANDLE=                    # optional; defaults to @ViciPeptides
ZELLE_HANDLE=                    # optional; defaults to support@vicipeptides.com

# ── Local tooling only — NOT read by the server ────────────────────────────
# Direct Postgres connection string for scripts/run-migration.js. The runtime
# uses SUPABASE_URL + SUPABASE_SERVICE_KEY and never reads these. Either name
# works; DATABASE_URL wins if both are set. Required only when you run that
# script, which applies migrations and must not be pointed at production
# casually. Supabase: Project Settings, Database, Connection string, URI.
DATABASE_URL=                    # optional; postgresql://... for scripts/run-migration.js
SUPABASE_DB_URL=                 # optional; alternative name for the same value
# One-shot input for scripts/set-password.js. Leave BLANK. The script prompts
# on a TTY when it is unset, which keeps the password out of shell history and
# out of this file. Never commit a value here.
NEW_PASSWORD=
