# Telnyx
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PHONE_NUMBER=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
# Legacy v1 HMAC secret retained for existing message processing.
WEBHOOK_SECRET=
# Public (not private) key from Telnyx Mission Control. Required before live
# delivery/reply evidence can enter revenue attribution or sentiment metrics.
TELNYX_PUBLIC_KEY=

# GoHighLevel
GHL_AGENCY_TOKEN=   # PIT token — needs contacts.readonly + conversations.readonly scopes
GHL_COMPANY_ID=
GHL_LOCATION_ID=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Analytics
# Business data is stored in UTC and reported using this reliable activity floor.
ANALYTICS_RELIABLE_FROM=2026-01-16
# Optional source-specific history floors used for honest partial-history notices.
ANALYTICS_MESSAGING_RELIABLE_FROM=2026-04-29
ANALYTICS_RECOVERY_RELIABLE_FROM=2026-05-27
ANALYTICS_CALLS_RELIABLE_FROM=2026-06-11
# Comma-separated E.164 phones / Woo order IDs excluded as staff, internal, or test data.
ANALYTICS_EXCLUDED_PHONES=
ANALYTICS_EXCLUDED_ORDER_IDS=

# Native on-device assistant pilot. Off by default. Only the exact lowercase
# value true exposes the capability to named Owner/Admin accounts that hold
# assistant.use. This does not enable a cloud model or any write operation.
ASSISTANT_ENABLED=false

# Campaign delivery brake. Keep false/absent until the provider has approved
# the exact promotional use and sms_campaign_settings is explicitly enabled.
# Draft and dry-run APIs remain available while this is false.
CAMPAIGNS_LIVE_SEND_ENABLED=false
# Opportunity detection may prepare drafts only when both the overall brake
# and the exact workflow brake are the lowercase value true. These remain
# separate from live delivery, which is always gated independently above.
CAMPAIGN_OPPORTUNITY_DRAFTS_ENABLED=false
CAMPAIGN_BACK_IN_STOCK_DETECTOR_ENABLED=false
CAMPAIGN_REORDER_DETECTOR_ENABLED=false
CAMPAIGN_WINBACK_DETECTOR_ENABLED=false
# How long the cached WooCommerce catalogue may be reused, in milliseconds.
# This is the BACKSTOP, not the primary invalidation: the product webhook drops
# the cache the moment a product changes. Optional; defaults to 15 minutes.
CAMPAIGN_CATALOGUE_TTL_MS=900000

# ── The portfolio opportunity detector ───────────────────────────────────────
# GET /api/campaigns/opportunities. Read-only: it counts customers and reports
# what has already happened. It writes nothing and sends nothing, so unlike the
# delivery loop there is no flag switching it off.
#
# How long a computed portfolio may be reused, in milliseconds. One refresh
# reads every paid order, every contact and the WooCommerce catalogue, so this
# is not a per-request cost. Optional; defaults to 6 hours, capped at 24.
CAMPAIGN_OPPORTUNITY_TTL_MS=21600000
# The shortest gap between two FORCED refreshes. Stops a held-down refresh
# control turning a screen into a load test against WooCommerce. Optional;
# defaults to 5 minutes.
CAMPAIGN_OPPORTUNITY_MIN_REFRESH_MS=300000
# The currency code order totals are reported in. `sms_orders` carries no
# currency column, so there is nothing per-order to read. No symbol is ever
# emitted; the code travels beside the number. Optional; defaults to USD, the
# same default lib/campaigns/attribution-generator.js already uses.
CAMPAIGN_REPORTING_CURRENCY=USD
# Approval for scripts/seed-product-inventory-baseline.js, which is the only
# writer in the product identity path. It writes nothing unless this is the
# exact value YES and --persist is also passed. Never set it in a deployed
# environment; it is a one-off operator action, not runtime configuration.
PRODUCT_INVENTORY_SEED_APPROVED=
# Separate APNs brake for permission-sensitive campaign review alerts. Draft
# persistence never implies that a notification may be delivered.
CAMPAIGN_REVIEW_NOTIFICATIONS_ENABLED=false
# Separate APNs brake for internal conversation handoffs. Referral rows and
# Activity events still work while this is off; no referral push reaches Apple
# unless the value is exactly lowercase `true`.
REFERRAL_NOTIFICATIONS_ENABLED=false
# Separate APNs brake for segment change alerts, off by default and read only
# by lib/apns-notify.js. Recomputing a segment never implies permission to
# wake anybody's phone about it.
SEGMENT_CHANGE_NOTIFICATIONS_ENABLED=false
# How many people must join or leave before a recompute counts as material and
# is worth a push. Blank or unset means 1. This governs the push somebody gets
# after pressing Recompute on ONE segment, and it also acts as a LOWER BOUND on
# the daily digest's own absolute floor below, so raising it raises both and the
# two can never contradict each other.
SEGMENT_CHANGE_NOTIFICATION_MIN_DELTA=1

# ── The daily segmentation cycle and the digest ────────────────────────────
# The clock that recomputes every automatic segment once a day, runs the
# opportunity detector, and sends at most one summary push per person per day.
# It is NOT a 24 hour setInterval: it ticks every few minutes and decides from
# the wall clock plus a claim row whose UNIQUE constraint is the guard, so a
# Railway redeploy cannot move the fire time. Requires
# scripts/daily-cycle-runs-migration.sql; without it the scheduler logs once and
# does nothing.
#
# THE DIGEST PUSH ITSELF IS OFF unless this is exactly the lowercase string
# true. With it off the cycle still recomputes, still decides materiality and
# still records the whole pass in the ledger. Nothing reaches a phone.
DAILY_DIGEST_NOTIFICATIONS_ENABLED=false
# How often the scheduler asks whether anything is due. Optional; defaults to
# 5 minutes, clamped between 30 seconds and 1 hour. Worst-case lateness for the
# whole feature is one of these, not one deploy cycle.
DAILY_CYCLE_TICK_MS=300000
# The OPERATIONAL anchor for the recompute: an IANA identifier, never an offset.
# This is a choice about when our own job runs, like the hour a backup starts.
# IT IS NOT THE BUSINESS TIME ZONE. Campaign quiet hours are enforced in SQL
# against sms_campaign_settings.business_timezone and nothing in this feature is
# read by that predicate. Optional; defaults to Europe/London.
DAILY_CYCLE_TIMEZONE=Europe/London
# The hour and minute, in the anchor zone above, at which the recompute runs.
# Early, so both operators' digests have fresh numbers. Optional; defaults 6:00.
DAILY_CYCLE_HOUR=6
DAILY_CYCLE_MINUTE=0
# How long a claimed run may sit unfinished before another process may take it
# over. Optional; defaults to 10 minutes. Long enough that a slow pass is never
# stolen from itself, short enough that a killed process does not cost the day.
# A COMPLETED run is never repeated, however old.
DAILY_CYCLE_STALE_CLAIM_MS=600000
# The population below which the cycle will not draft proposals for a finding.
# 100 is COHORT_CALIBRATION.actionableFloorPeople: below it a cohort's own
# observed rate is consistent with almost any true rate. Optional.
DAILY_CYCLE_PROPOSAL_FLOOR_PEOPLE=100
# The digest hour and minute, applied in EACH ACCOUNT'S OWN sms_users.timezone,
# so 08:30 means 08:30 in London and 08:30 in New York. Optional; defaults 8:30.
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=30
# Monday to Friday. Set to the exact string false to include the weekend;
# anything else, including unset, keeps weekdays only. The RECOMPUTE still runs
# every day: it is the notification that is weekdays only, not the arithmetic.
DAILY_DIGEST_WEEKDAYS_ONLY=true
# MATERIALITY, and it is a CONJUNCTION: a segment moved enough only when
# delta >= DAILY_DIGEST_MIN_DELTA *and* delta >= this fraction of its prior
# size. Each test alone fails in the opposite direction: 3 out of 500 is noise
# and passes an absolute-only test, 1 out of 3 is 33 per cent and passes a
# relative-only one. Optional; default 3 and 0.10.
DAILY_DIGEST_MIN_DELTA=3
DAILY_DIGEST_MIN_RELATIVE_DELTA=0.10
# The revenue-critical exception. These lists are small and high intent by
# definition, so one arrival is worth saying. Comma separated segment keys.
DAILY_DIGEST_CRITICAL_SEGMENTS=reorder_due_high_confidence,reorder_due,back_in_stock_nearly_due
DAILY_DIGEST_CRITICAL_MIN_DELTA=1
# Bulk import guard. If the customer base moved by more than this fraction since
# the previous run, every segment changed at once and none of it is customer
# behaviour, so the digest is suppressed. Optional; defaults to 0.15.
DAILY_DIGEST_BULK_CHANGE_FRACTION=0.15
# How many previous days of headline claims suppress a repeat. Without this a
# slow trend fires an identical push every morning for a fortnight, which is the
# pattern that trains somebody to ignore and then disable. Optional; default 3.
DAILY_DIGEST_NOVELTY_DAYS=3
# LLM-drafted campaign copy. Off unless the value is exactly the lowercase
# string true. The model only proposes wording for a human to pick and edit:
# every draft must still pass lib/campaigns/copy-validator.js, and drafting is
# not review, approval, scheduling, or permission to send.
CAMPAIGN_AI_COPY_ENABLED=false
# Describing a segment in plain words. Off unless the value is exactly the
# lowercase string true. The model drafts RULES only: it never creates a
# segment, never returns a list of people, and never sees a customer. Every
# rule it writes must pass lib/campaigns/segment-rule-validator.js, an
# operator must read the rules in plain English and preview the real count,
# and saving is a separate, explicit step. A segment is not permission to send.
SEGMENT_AI_BUILDER_ENABLED=false
# Turning a detected cohort opportunity into reviewable campaign proposals. Off
# unless the value is exactly the lowercase string true. Several proposals are
# produced per opportunity, one per mechanism from the closed catalogue in
# lib/campaigns/proposal-mechanisms.js, and the model writes only the wording:
# it chooses no mechanism, no audience and no number. Every drafted message
# must pass lib/campaigns/copy-validator.js or the proposal is never shown.
# A proposal is not a campaign. Accepting one creates an ordinary campaign
# DRAFT that still needs submit, review, approval and both live-send brakes.
CAMPAIGN_OPPORTUNITY_PROPOSALS_ENABLED=false
# Keep blank/off. Set to the exact value YES only for a separately approved
# historical write, and still pass --persist to the relevant backfill script.
ANALYTICS_BACKFILL_APPROVED=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Enforced in code on every request: only these reviewed models/providers may run.
OPENROUTER_ALLOWED_MODELS=anthropic/claude-haiku-4.5
OPENROUTER_ALLOWED_PROVIDERS=amazon-bedrock,google-vertex

# Private call recordings
CALL_RECORDING_RETENTION_DAYS=30
CALL_RECORDING_SIGNED_URL_SECONDS=60
# Destructive retention remains off until the owner approves the first dry run.
CALL_RECORDING_RETENTION_ENFORCED=false

# Auth
INBOX_PASSWORD=
SESSION_SECRET=

# App
PORT=3000
NODE_ENV=production
APP_URL=

# ── Outbound email (Maton, via the authorised Gmail connection) ────────────
# Used by lib/email.js for the invitation email and nothing else yet.
#
# Maton rather than an SMTP/API provider because it needs NO DNS CHANGES.
# vicipeptides.com mail is hosted elsewhere and its records are not to be
# touched; the Gmail connection is already authorised and already sends as
# support@vicipeptides.com, so there is no sending domain to verify.
#
# All THREE of MATON_API_KEY, MATON_GMAIL_CONNECTION_ID and EMAIL_FROM are
# required before a single message is sent. With any of them missing,
# sendEmail() returns { sent: false, reason: 'not_configured' }, logs once, and
# never throws — invitations still succeed and still return their link, and the
# API response says emailSent: false so nobody is told a mail went that did not.
#
# Find the connection id with:
#   curl -H "Authorization: Bearer $MATON_API_KEY" https://ctrl.maton.ai/connections
# and take the id of the ACTIVE google-mail connection. Never paste a real key
# or a real connection id into this file.
MATON_API_KEY=                   # Maton API key (leave blank to disable email)
MATON_GMAIL_CONNECTION_ID=       # id of the ACTIVE google-mail connection, sent as the Maton-Connection header
EMAIL_FROM=                      # bare address only, e.g. support@vicipeptides.com — must match the connection
EMAIL_FROM_NAME=Vici Inbox       # optional display name; defaults to "Vici Inbox"
# APP_URL above must also be set: it builds the ${APP_URL}/accept-invite?token=...
# link inside the invitation email. Without it no invitation email is sent.

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Accounts, roles and the Activity Center ────────────────────────────────
# The shared INBOX_PASSWORD login still works and resolves to one named
# "Team" identity. These two control it. Retiring the shared password once
# everyone has a named account is a flip of the first, not a deploy.
LEGACY_SHARED_LOGIN=enabled          # enabled | disabled
LEGACY_SHARED_ROLE=admin             # admin | agent — reconciled into the DB at boot

# SESSION_SECRET is now MANDATORY. The server refuses to start without it,
# because the old fallback value was committed to this repository and an unset
# secret meant the session cookie signature was forgeable from the source.

# ── Machine credentials ────────────────────────────────────────────────────
# Bearer token for POST /admin/* (backfills, release-notify). Falls back to
# INBOX_PASSWORD when unset, so the current deploy is unaffected. Set it so the
# machine credential can be rotated without changing the login people type.
ADMIN_API_TOKEN=
# Dedicated secret for the GHL automation calling POST /webhook/send. Falls back
# to WEBHOOK_SECRET, which is also the legacy Telnyx v1 signing secret. Set this
# so one value stops serving two unrelated purposes.
GHL_WEBHOOK_SECRET=

# ── APNs (native iPhone push) ──────────────────────────────────────────────
# REQUIRED for any native iOS notification: message alerts from the Telnyx
# inbound webhook, badge counts, and POST /admin/release-notify. lib/apns-notify.js
# returns null and silently sends nothing unless all three of KEY_ID, TEAM_ID and
# KEY_P8_BASE64 are set. AGENTS.md names them as Railway runtime configuration.
# These are a dedicated Apple Developer APNs key — NOT the App Store Connect API
# key and NOT the Telnyx VoIP credential. Never paste a real .p8 into this file.
APNS_KEY_ID=                     # 10-char Key ID of the APNs .p8 (required for iOS push)
APNS_TEAM_ID=                    # 10-char Apple Developer Team ID (required for iOS push)
APNS_KEY_P8_BASE64=              # base64 of the APNs .p8 private key (required for iOS push)
# Optional. Push topic / app bundle id. Defaults to com.vicipeptides.inbox.
# Also used by lib/apple-site-association.js as the bundle id inside the
# universal-link appIDs entry, so the push topic and the link claim cannot drift.
APNS_BUNDLE_ID=

# -- Universal links (iOS opens the invite link in the app) -----------------
# Serves /.well-known/apple-app-site-association, which iOS fetches before it
# will let ${APP_URL}/accept-invite?token=... open the native app instead of
# Safari. WITHOUT A TEAM ID THE DOCUMENT IS NOT SERVED AT ALL (404), by design:
# iOS caches the association it is given, so publishing one with the wrong team
# breaks the link and keeps it broken after the value is corrected. A missing
# document just means the link opens in a browser, which is the old behaviour.
#
# Optional in practice. lib/apple-site-association.js falls back to APNS_TEAM_ID
# above, which is the SAME 10-character Apple Developer Team ID and is already
# set in Railway. Set this only if the two ever need to differ.
# NOT the App Store Connect issuer id and NOT its key id; AGENTS.md names those
# as distinct identifiers that must never be substituted for one another.
APPLE_TEAM_ID=                   # optional; 10-char Apple Developer Team ID, defaults to APNS_TEAM_ID

# -- Staged universal-link claim: email-change confirmation ------------------
# Publishes /confirm-email-change in the association document so that opening a
# confirmation link on an iPhone opens the Vici Inbox app rather than Safari.
#
# OFF BY DEFAULT, AND THE ORDER IS NOT OPTIONAL. iOS caches this document. The
# backend half ships in a deploy; the client half ships in a TestFlight build
# days later, and the build already on somebody's phone cannot be updated
# retroactively. Turn this on BEFORE such a build is in the field and every
# confirmation link opens the app to nothing. Leave it off and the link opens
# public/confirm-email-change.html, which completes the change in any browser.
#
# Set it to exactly: enabled (true, yes and 1 are also accepted). Anything else,
# including blank, leaves the claim unpublished. Turning it back off is a
# variable change and a restart, with no App Store round trip.
APPLE_CLAIM_EMAIL_CHANGE=         # optional; set to `enabled` once the iOS build routes /confirm-email-change

# -- TestFlight tester provisioning (App Store Connect API) ------------------
# Used by lib/testflight-testers.js from POST /api/invitations only. A new
# teammate cannot install the app until Apple knows them as a beta tester, so
# inviting somebody also registers them with App Store Connect and Apple emails
# them the TestFlight invitation.
#
# ALL FOUR of ASC_ISSUER_ID, ASC_KEY_ID, ASC_KEY_P8_BASE64 and ASC_BETA_GROUP_ID
# are required before a single call is made. With any of them missing the module
# returns { added: false, reason: 'not_configured' }, logs once, and never
# throws -- the invitation still succeeds, still returns its link, and the API
# response says testFlightInvited: false so nobody is told a tester was added
# who was not. That is the state on deploy day.
#
# This must be an Admin TEAM key. AGENTS.md: individual App Store Connect API
# keys cannot use the Provisioning endpoints. Never paste a real .p8 or issuer
# id into this file. The same three names exist as GitHub Actions secrets for
# the TestFlight upload workflow; these are the Railway runtime copies.
ASC_ISSUER_ID=                   # required for TestFlight provisioning; App Store Connect issuer UUID
ASC_KEY_ID=                      # required for TestFlight provisioning; 10-char App Store Connect key id
ASC_KEY_P8_BASE64=               # required for TestFlight provisioning; base64 of the App Store Connect .p8
ASC_BETA_GROUP_ID=               # required for TestFlight provisioning; UUID of the beta group testers join
# Optional. The numeric App Store app id the beta group belongs to. It is NOT
# sent in the betaTesters create request -- the group already identifies the app
# -- so a missing value never blocks provisioning. It is recorded in the audit
# summary so "which app did we just give this person access to?" is answerable
# without a lookup.
ASC_APP_ID=                      # optional; numeric App Store app id, for the audit summary only

# ── Dedicated iOS SIP credential ───────────────────────────────────────────
# Optional but strongly preferred. lib/voice-credentials.js uses this pair only
# when BOTH are present, so a half-applied update can never mix credentials from
# two different SIP users. When either is missing it falls back to the legacy
# TELNYX_SIP_USERNAME / TELNYX_SIP_PASSWORD above, which is the rollback path —
# never overwrite or delete the legacy pair during a rotation.
TELNYX_IOS_SIP_USERNAME=         # optional; set together with the password below
TELNYX_IOS_SIP_PASSWORD=         # optional; set together with the username above

# ── WooCommerce ────────────────────────────────────────────────────────────
# REQUIRED for orders, payment-recovery flows and revenue attribution.
# WC_URL is optional; woocommerce.js defaults to the production store's
# /wp-json/wc/v3 root when it is unset.
WC_URL=                          # optional; WooCommerce REST v3 base URL
WC_CONSUMER_KEY=                 # REQUIRED — Woo REST consumer key (ck_...)
WC_CONSUMER_SECRET=              # REQUIRED — Woo REST consumer secret (cs_...)
# Optional but recommended. HMAC secret for POST /webhook/woocommerce. When
# unset the signature check is SKIPPED, so set it in any deployed environment.
WC_WEBHOOK_SECRET=

# ── ShipStation ────────────────────────────────────────────────────────────
# REQUIRED for shipment/delivery flows and tracking lookups.
SS_API_KEY=                      # REQUIRED — ShipStation API key
SS_API_SECRET=                   # REQUIRED — ShipStation API secret
# Optional but recommended. Shared secret compared against the ShipStation
# webhook. When unset the check is SKIPPED, so set it in any deployed environment.
SS_WEBHOOK_SECRET=

# ── Payment handles shown in recovery SMS copy ─────────────────────────────
# Optional. Both have hard-coded defaults in flows/failed.js and flows/hold.js;
# set them only to override what customers are told to pay to.
VENMO_HANDLE=                    # optional; defaults to @ViciPeptides
ZELLE_HANDLE=                    # optional; defaults to support@vicipeptides.com

# ── Local tooling only — NOT read by the server ────────────────────────────
# Direct Postgres connection string for scripts/run-migration.js. The runtime
# uses SUPABASE_URL + SUPABASE_SERVICE_KEY and never reads these. Either name
# works; DATABASE_URL wins if both are set. Required only when you run that
# script, which applies migrations and must not be pointed at production
# casually. Supabase: Project Settings, Database, Connection string, URI.
DATABASE_URL=                    # optional; postgresql://... for scripts/run-migration.js
SUPABASE_DB_URL=                 # optional; alternative name for the same value
# One-shot input for scripts/set-password.js. Leave BLANK. The script prompts
# on a TTY when it is unset, which keeps the password out of shell history and
# out of this file. Never commit a value here.
NEW_PASSWORD=

# Assistant voice. The key stays server side: the iOS app asks Vici for audio,
# never ElevenLabs directly, because anything in an app binary can be extracted.
ELEVENLABS_API_KEY=
# Optional. Defaults to Elise from the community library, and the low latency
# turbo model. Override only to change the default voice for everybody.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# One-shot input for scripts/stage-winback-campaigns.js: the user id recorded
# as the creator of the staged draft campaigns. Optional; defaults to 4. Not
# read by the server, and it grants nothing — the draft still has to be
# reviewed and approved in the app by somebody with the permission.
STAGE_ACTOR_USER_ID=
