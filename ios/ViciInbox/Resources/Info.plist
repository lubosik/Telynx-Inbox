<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Vici Inbox</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Required for PushKit VoIP pushes to wake a terminated app,
	     and for call audio to run in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
		<string>audio</string>
		<string>remote-notification</string>
	</array>

	<!-- Microphone is mandatory for a softphone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Vici Inbox uses the microphone for customer calls and, only while you are asking the Assistant a question, to turn what you say into text on this iPhone. It is never left listening: you start it, and it stops when you finish speaking.</string>
	<!-- TelnyxRTC links WebRTC camera APIs even though the current app is audio-first.
	     App Store validation therefore requires a camera purpose string. -->
	<key>NSCameraUsageDescription</key>
	<string>Vici Inbox uses the camera when you choose to enable video during a call.</string>
	<key>NSContactsUsageDescription</key>
	<string>Vici Inbox can show customer names on incoming calls.</string>
	<!-- Message attachments can be explicitly saved by the operator. The app
	     requests add-only access and does not browse the library through PhotoKit. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Vici Inbox needs permission to save message images to your Photos library.</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
